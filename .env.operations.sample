# Operations profile (observability-oriented)
# Usage (PowerShell):
#   Copy-Item .env.operations.sample .env

SF_AI_DOTENV_DISABLE=0

# Postgres (required for production)
POSTGRES_USER=sfai
POSTGRES_DB=sfai_prod
# POSTGRES_PASSWORD はコミットしない（Secret Manager / CI secret / ローカル未追跡 .env で設定）
# DATABASE_URL には実際の接続文字列を直接設定（dotenv の変数展開には依存しない）
DATABASE_URL=postgres://sfai:REPLACE_WITH_SECRET@postgres.internal:5432/sfai_prod
DATABASE_POOL_SIZE=20
DATABASE_POOL_IDLE_TIMEOUT_MS=30000

# Backend switchers (production: all postgres/pgvector/pg-boss)
SF_AI_STATE_BACKEND=postgres
SF_AI_PROPOSAL_QUEUE_BACKEND=pg-boss
SF_AI_VECTOR_BACKEND=pgvector
PG_VECTOR_POOL_SIZE=10

# Use absolute paths when sharing one MCP server across multiple repositories.
SF_AI_OUTPUTS_DIR=D:/sf-ai-data/outputs
SF_AI_HISTORY_SQLITE=false
SF_AI_STATE_DB_PATH=D:/sf-ai-data/outputs/state.sqlite
SF_AI_OUTPUTS_BACKUP_DIR=D:/sf-ai-data/outputs/backups
SF_AI_OUTPUTS_BACKUP_KEEP=7

SF_AI_MEMORY_FILE=D:/sf-ai-data/outputs/memory.jsonl
SF_AI_VECTOR_STORE_FILE=D:/sf-ai-data/outputs/vector-store.jsonl
SF_AI_TRACE_FILE=D:/sf-ai-data/outputs/events/trace-log.jsonl
SF_AI_METRICS_FILE=D:/sf-ai-data/outputs/events/metrics-samples.jsonl

LOG_LEVEL=info
SF_AI_DEBUG_VERBOSE_PROMPT=false
SF_AI_LOCALE=ja

AI_LOW_RELEVANCE_THRESHOLD=6

SF_AI_AUTO_MEMORY=false
SF_AI_PROGRESS_BANNER=true

# LangSmith integration
SF_AI_LANGSMITH_ENABLED=true
# LANGSMITH_API_KEY はコミットしない（Secret Manager / CI secret / ローカル未追跡 .env で設定）
LANGSMITH_TRACING_ENABLED=true

# Learning metrics auto update (TASK-8)
SF_AI_METRICS_REPORTING_HOURS=24
SF_AI_METRICS_WITH_DRIFT=true
SF_AI_DRIFT_BASELINE_HOURS=168
SF_AI_DRIFT_RECENT_HOURS=24
SF_AI_DRIFT_MIN_REWARD_SAMPLES=20
SF_AI_DRIFT_MIN_REPUTATION_SAMPLES=3
SF_AI_DRIFT_THRESHOLD=0.15
SF_AI_REGRESSION_THRESHOLD=0.1
SF_AI_DRIFT_REPORT_PATH=D:/sf-ai-data/outputs/reports/drift-regression.jsonl

AI_PROMPT_CACHE_MAX_ENTRIES=200
AI_PROMPT_CACHE_TTL_SECONDS=600
PROMPT_CACHE_FILE=D:/sf-ai-data/outputs/prompt-cache.jsonl

AI_AGENT_TRUST_SCORING_ENABLED=true
AI_AGENT_TRUST_THRESHOLD=0.55

SF_AI_AUTO_APPLY=false
SF_AI_AUTO_APPLY_MIN_SCORE=70
SF_AI_AUTO_APPLY_MAX_PER_DAY=5
SF_AI_AUTO_APPLY_MAX_DELETIONS=3

OLLAMA_REQUIRED=false
OLLAMA_BASE_URL=http://ollama.internal:11434
AI_LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_INIT_MODELS=qwen2.5:3b nomic-embed-text:latest
OLLAMA_JUDGE_MODEL=qwen2.5:3b
OLLAMA_JUDGE_CONCURRENCY=4

# Cleanup scheduler
CLEANUP_SCHEDULER_QUEUE=governance-auto-cleanup

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.internal:4318
OTEL_SERVICE_NAME=salesforce-ai-company-prod
PROMETHEUS_METRICS_PORT=9464

SF_AI_BENCHMARK_TRACE_LIMIT=500