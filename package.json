{
  "name": "salesforce-ai-company",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "sf-ai": "scripts/sf-ai.cjs"
  },
  "scripts": {
    "help": "node scripts/help.js",
    "init": "node scripts/init-config.js",
    "doctor": "node scripts/doctor.js",
    "build": "tsc -p tsconfig.json",
    "mcp:dev": "tsx mcp/server.ts",
    "mcp:start": "node dist/mcp/server.js",
    "mcp:start:docker": "node scripts/start-mcp-with-docker.mjs",
    "mcp:dev:docker": "node scripts/start-mcp-with-docker.mjs -- npx tsx mcp/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "vector:migrate:pgvector": "tsx scripts/migrate-vector-to-pgvector.ts",
    "test": "node scripts/test.mjs",
    "lint": "eslint .",
    "lint:core-layers": "node --import tsx scripts/lint-core-layers.ts",
    "lint:depcruise": "depcruise --config .dependency-cruiser.cjs mcp --output-type err-long",
    "lint:docs": "node --import tsx scripts/lint-docs.ts",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"{mcp,scripts,tests,memory}/**/*.{ts,js,mjs,cjs,json}\" --write",
    "format:check": "prettier \"{mcp,scripts,tests,memory}/**/*.{ts,js,mjs,cjs,json}\" --check",
    "ci": "npm run typecheck && npm run lint:core-layers && npm run lint && npm test && npm run audit:deps",
    "sf": "node scripts/sfdx-wrapper.js",
    "scaffold": "tsx scripts/scaffold.ts",
    "clean:outputs": "tsx scripts/cleanup-outputs.ts",
    "mask:logs": "tsx scripts/mask-existing-logs.ts",
    "archive:history": "tsx scripts/archive-history.ts",
    "report:metrics": "node scripts/metrics-report.js",
    "metrics:update": "tsx mcp/core/learning/metrics-auto-update.ts",
    "metrics:update:drift": "tsx mcp/core/learning/metrics-auto-update.ts --with-drift",
    "lint:outputs": "node --import tsx scripts/lint-outputs.ts",
    "docs:tools": "tsx scripts/generate-tools-doc.ts",
    "docs:manifest": "tsx scripts/generate-tool-manifest.ts",
    "docs:error-codes": "tsx scripts/generate-error-codes-doc.ts",
    "docs:build": "npm run docs:tools && npm run docs:manifest && npm run docs:error-codes",
    "ai": "tsx scripts/ai.ts",
    "eval:ci": "tsx scripts/eval-suite.ts --ci",
    "eval:save-baseline": "tsx scripts/eval-suite.ts --save-baseline",
    "replay:session": "tsx scripts/replay-session.ts",
    "evals:run": "tsx scripts/evals-run.ts",
    "migrate:tenant-scope": "tsx scripts/migrate-tenant-scope.ts",
    "release:notes": "tsx scripts/release-notes.ts",
    "dr:drill": "tsx scripts/dr-drill.ts",
    "typecheck": "tsc --noEmit",
    "audit:deps": "npm audit --audit-level=moderate",
    "sf-ai": "node scripts/sf-ai.cjs"
  },
  "dependencies": {
    "@apexdevtools/apex-parser": "^4.4.1",
    "@hono/node-server": "^2.0.1",
    "@langchain/community": "^0.3.59",
    "@langchain/core": "^0.3.80",
    "@langchain/ollama": "^0.2.4",
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.56.1",
    "@opentelemetry/context-async-hooks": "^2.7.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/instrumentation-pg": "^0.57.0",
    "@opentelemetry/sdk-node": "^0.57.2",
    "@temporalio/client": "^1.17.0",
    "@temporalio/worker": "^1.17.0",
    "@temporalio/workflow": "^1.17.0",
    "ajv": "^8.20.0",
    "awilix": "^12.1.1",
    "chalk": "^5.6.2",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "croner": "^10.0.1",
    "diff": "^9.0.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "fast-glob": "^3.3.3",
    "fast-xml-parser": "^5.0.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.17",
    "i18next": "^26.0.8",
    "js-tiktoken": "^1.0.16",
    "lru-cache": "^11.3.5",
    "ora": "^9.4.0",
    "p-limit": "^7.3.0",
    "p-retry": "^8.0.0",
    "p-timeout": "^7.0.1",
    "pg": "^8.20.0",
    "pg-boss": "^12.18.1",
    "pgvector": "^0.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "simple-git": "^3.36.0",
    "write-file-atomic": "^7.0.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "dependency-cruiser": "^16.10.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.6.0",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
