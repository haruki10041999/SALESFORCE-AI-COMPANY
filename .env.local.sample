# Local development profile (safe defaults)
# Usage (PowerShell):
#   Copy-Item .env.local.sample .env

SF_AI_DOTENV_DISABLE=0
SF_AI_PROFILE=local
SF_AI_PROFILE_STRICT=true
SF_AI_OUTPUTS_DIR=outputs
SF_AI_HISTORY_SQLITE=false
SF_AI_STATE_DB_PATH=outputs/state.sqlite

# Backend switchers: "sqlite" | "postgres"
SF_AI_STATE_BACKEND=sqlite
SF_AI_PROPOSAL_QUEUE_BACKEND=file
# Backend switchers: "tfidf" | "ngram" | "ollama" | "pgvector"
SF_AI_VECTOR_BACKEND=tfidf
SF_AI_LLM_CLIENT=native

# Postgres (optional - only when STATE_BACKEND=postgres or PROPOSAL_QUEUE_BACKEND=pg-boss)
# POSTGRES_USER=sfai
# POSTGRES_PASSWORD=sfai
# POSTGRES_DB=sfai
# DATABASE_URL=postgres://sfai:sfai@localhost:5432/sfai

# ---- Ollama 連携 (任意 - local dev) -----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REQUIRED=false
AI_LLM_PROVIDER=ollama
OLLAMA_INIT_MODELS=qwen2.5:3b nomic-embed-text:latest

LOG_LEVEL=info
SF_AI_DEBUG_VERBOSE_PROMPT=false
SF_AI_LOCALE=ja

AI_LOW_RELEVANCE_THRESHOLD=6

SF_AI_AUTO_MEMORY=false
SF_AI_PROGRESS_BANNER=true

# ---- LangSmith (optional - local dev では既定 OFF) -----
SF_AI_LANGSMITH_ENABLED=false
# LANGSMITH_API_KEY=ls_... (本番運用で設定)

# Learning metrics auto update (TASK-8)
SF_AI_METRICS_REPORTING_HOURS=24
SF_AI_METRICS_WITH_DRIFT=false
SF_AI_DRIFT_BASELINE_HOURS=168
SF_AI_DRIFT_RECENT_HOURS=24
SF_AI_DRIFT_MIN_REWARD_SAMPLES=20
SF_AI_DRIFT_MIN_REPUTATION_SAMPLES=3
SF_AI_DRIFT_THRESHOLD=0.15
SF_AI_REGRESSION_THRESHOLD=0.1
SF_AI_DRIFT_REPORT_PATH=outputs/reports/drift-regression.jsonl

AI_PROMPT_CACHE_MAX_ENTRIES=100
AI_PROMPT_CACHE_TTL_SECONDS=600
PROMPT_CACHE_FILE=outputs/prompt-cache.jsonl

AI_AGENT_TRUST_SCORING_ENABLED=false
AI_AGENT_TRUST_THRESHOLD=0.55

SF_AI_AUTO_APPLY=false
SF_AI_AUTO_APPLY_MIN_SCORE=70
SF_AI_AUTO_APPLY_MAX_PER_DAY=5
SF_AI_AUTO_APPLY_MAX_DELETIONS=3

SF_AI_DOCKER_SERVICES=postgres,ollama
SF_AI_WAIT_FOR_PORTS=5432,11434
SF_AI_DOCKER_WAIT_TIMEOUT_MS=120000
SF_AI_DOCKER_WAIT_INTERVAL_MS=1000

# ---- Observability (local default: disabled) -----
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=salesforce-ai-company-local
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# PROMETHEUS_METRICS_PORT=9464

SF_AI_BENCHMARK_TRACE_LIMIT=300

# ---- Notes -----
# 本ファイルは minimal な依存で動作するよう設計。
# Postgres を使いたい場合は .env.sample をコピーして
# DATABASE_URL と各 backend を postgres/pg-boss/pgvector に変更してください。