# Unified environment template (T-28)
# Copy to .env, then apply one overlay from env.profiles/*.overlay.

# Loader / profile
SF_AI_DOTENV_DISABLE=0
SF_AI_PROFILE=local
SF_AI_PROFILE_STRICT=true
SF_AI_ENV_VALIDATE=true

# Persistence backends
SF_AI_STATE_BACKEND=sqlite
SF_AI_PROPOSAL_QUEUE_BACKEND=file
SF_AI_VECTOR_BACKEND=tfidf
# Workflow policy (T09): temporal-first. in-process is test-only via explicit escape hatch.
SF_AI_WORKFLOW_ENGINE=temporal
SF_AI_ALLOW_IN_PROCESS_WORKFLOW=false

# Temporal workflow runtime (used when SF_AI_WORKFLOW_ENGINE=temporal)
SF_AI_TEMPORAL_ADDRESS=localhost:7233
SF_AI_TEMPORAL_NAMESPACE=default
SF_AI_TEMPORAL_TASK_QUEUE=sfai-orchestration
SF_AI_TEMPORAL_RUN_WORKER=true
SF_AI_TEMPORAL_WORKFLOW_RETRY_MAX_ATTEMPTS=1
SF_AI_TEMPORAL_ACTIVITY_TIMEOUT_SECONDS=60
SF_AI_TEMPORAL_ACTIVITY_RETRY_MAX_ATTEMPTS=3
SF_AI_TEMPORAL_ACTIVITY_RETRY_INITIAL_INTERVAL_MS=1000
SF_AI_TEMPORAL_ACTIVITY_RETRY_BACKOFF_COEFFICIENT=2

# Required when SF_AI_STATE_BACKEND=postgres
# DATABASE_URL=postgres://sfai:sfai@localhost:5432/sfai
# Outbox dispatch daemon (requires DATABASE_URL)
SF_AI_OUTBOX_DISPATCH_ENABLED=true
SF_AI_OUTBOX_DISPATCH_INTERVAL_SECONDS=30
SF_AI_OUTBOX_DISPATCH_LIMIT=200
SF_AI_OUTBOX_QUEUE_PREFIX=outbox
# SIEM export outbox mode (optional)
# SF_AI_SIEM_OUTBOX_TOPIC=siem.export.request
# SF_AI_SIEM_OUTBOX_DISPATCH_NOW=false
# SF_AI_SIEM_OUTBOX_DISPATCH_LIMIT=200

# Secret backend
SF_AI_SECRET_BACKEND=env
# Optional: verify policy-bundle.sig using Ed25519 public key
# SF_AI_POLICY_BUNDLE_PUBLIC_KEY_PATH=secrets/policy-bundle.public.pem
# Required when SF_AI_SECRET_BACKEND=vault
# SF_AI_VAULT_ADDR=http://127.0.0.1:8200
# SF_AI_VAULT_AUTH_VALUE=replace-with-runtime-value

# Runtime / outputs
SF_AI_OUTPUTS_DIR=outputs
LOG_LEVEL=info
SF_AI_LOCALE=ja
SF_AI_REPLAY_MODE=observe
SF_AI_REPLAY_REQUIRE_LLM_CACHE_HIT=false
# Vector lifecycle scheduler (T12)
# SF_AI_VECTOR_LIFECYCLE_ENABLED=false
# SF_AI_VECTOR_LIFECYCLE_CRON=0 3 * * *
# SF_AI_VECTOR_HOT_TO_WARM_DAYS=7
# SF_AI_VECTOR_WARM_TO_COLD_DAYS=90
# SF_AI_VECTOR_LIFECYCLE_RUN_ON_STARTUP=false
# SF_AI_VECTOR_LIFECYCLE_STARTUP_LIMIT=2000

# MCP transport
MCP_TRANSPORT=stdio
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3800
# MCP_HTTP_CORS_ORIGIN=*
# MCP_HTTP_RATE_LIMIT_PER_MIN=120

# Optional integrations
AI_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
SF_AI_LANGSMITH_ENABLED=false

# Metrics / tracing
PROMETHEUS_METRICS_PORT=0
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SF_AI_METRICS_REPORTING_HOURS=24
SF_AI_METRICS_WITH_DRIFT=false
SF_AI_LEARNING_ORCHESTRATOR_ENABLED=false
# SF_AI_LEARNING_SNAPSHOT_PATH=outputs/learning/model-registry.snapshot.json
# SF_AI_LEARNING_MODEL_NAMES=ranker
# SF_AI_LEARNING_CURRENT_CANARY_MAP=ranker:v2
# SF_AI_LEARNING_CANARY_STATE_PATH=outputs/learning/current-canary-map.json
# SF_AI_LEARNING_CANARY_TRAFFIC_PERCENT=5
# SF_AI_LEARNING_MANUAL_APPROVAL_REQUIRED=false
# SF_AI_LEARNING_MANUAL_OVERRIDE=approve
# SF_AI_LEARNING_ACTOR_ID=learning-orchestrator
# SF_AI_LEARNING_ORCHESTRATOR_REPORT_PATH=outputs/reports/learning-orchestrator-latest.json

# Patroni (HA Postgres) passwords — supply via secrets manager or runtime env; never commit real values
# PATRONI_SUPERUSER_PASSWORD=
# PATRONI_REPLICATION_PASSWORD=
# PATRONI_ADMIN_PASSWORD=
