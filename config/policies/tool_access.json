{
  "version": "1.0",
  "defaultEffect": "allow",
  "rules": [
    {
      "id": "deny.apply_resource_actions.non_admin",
      "effect": "deny",
      "tools": ["apply_resource_actions"],
      "roles": ["operator", "viewer", "reviewer"]
    },
    {
      "id": "deny.apply_proposal.viewer",
